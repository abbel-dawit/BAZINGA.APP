{
  "name": "BAZINGA!",
  "short_name": "BAZINGA!",
  "description": "BAZINGA! \u2014 Music Made For You. Your music as YouTube music videos & audio, in one free player.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#060607",
  "theme_color": "#060607",
  "categories": [
    "music",
    "entertainment"
  ],
  "icons": [
    {
      "src": "icons/app-192.png?v=4",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png?v=4",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/app-maskable-512.png?v=4",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "id": "./",
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "handle_links": "preferred",
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "share_title",
      "text": "share_text",
      "url": "share_url"
    }
  },
  "related_applications": [
    {
      "platform": "webapp",
      "url": "manifest.webmanifest"
    }
  ],
  "prefer_related_applications": false
}
